# ============================================================
# AI Video Recap Platform — environment template
# ------------------------------------------------------------
# COPY this file to `.env` and fill in REAL values:
#     cp .env.example .env
#
# ALL values below are obviously-fake PLACEHOLDERS — never real
# keys. Real secrets must ONLY live in `.env` (git-ignored) or in
# your cloud provider's secret manager (Cloudflare Pages env vars,
# Hugging Face Spaces secrets, Render environment variables).
#
# NEVER commit a real .env file. NEVER paste real keys into code.
#
# Every variable here maps 1:1 to a field in backend/config.py
# (class Settings) unless marked "frontend-only" / "infra-only".
# ============================================================

# ---- App ----
APP_NAME=AI Video Recap Platform
APP_VERSION=0.1.0
ENV=development
# Public base URL of THIS backend. Used for email download links and as the
# fallback for local download URLs (API responses prefer the incoming
# request's base URL). MUST be the public URL in production
# (e.g. https://api.yourdomain.com) — localhost here breaks prod email links.
API_BASE_URL=http://localhost:8000

# Dev-only auth bypass (tests/local dev ONLY). NEVER enable in production:
# when ENV=development and DEV_AUTH_BYPASS=1, the API accepts
# "Authorization: Bearer dev-token-<user-id>" as that user.
DEV_AUTH_BYPASS=0

# Admin users (comma-separated emails; matched against the Supabase JWT email)
ADMIN_EMAILS=admin@PLACEHOLDER_DOMAIN.example

# ---- Database (Supabase free PostgreSQL) ----
# Pooled connection string from Supabase project settings > Database.
# (Used by CI/ops tooling; the app itself uses SUPABASE_URL + SUPABASE_KEY.)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxxxxxxxx.supabase.co:6543/postgres

# ---- Supabase (project config + backend service role) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NOTE: service_role key — backend ONLY (bypasses Row Level Security).
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SERVICE_ROLE_KEY_PLACEHOLDER
# Anon key is also exposed to the frontend as NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ANON_KEY_PLACEHOLDER
# HS256 JWT secret for verifying Supabase auth tokens server-side.
# Leave empty to use JWKS (RS256) discovery instead.
SUPABASE_JWT_SECRET=PLACEHOLDER_SUPABASE_JWT_SECRET

# ---- Storage (local fallback mirrors the /uploads /processing /results layout) ----
# Local fallback root; cloud deployments use R2 / Supabase Storage below.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
SUPABASE_STORAGE_BUCKET=recap-results
UPLOAD_CHUNK_SIZE=2097152
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SEC=1800

# ---- Redis / Celery queue (local compose; cloud uses managed Redis URL) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Dev/test escape hatch: run tasks eagerly without a broker
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT_SEC=3600
CELERY_TASK_SOFT_TIME_LIMIT_SEC=3300

# ---- AI providers (system-owner managed) ----
# Server keys are spent ONLY on jobs from the single owner account
# (OWNER_EMAIL below). Every other user MUST bring both their own
# Gemini + Groq keys via Settings -> the keys are sent as form fields
# with each upload and travel as Celery task kwargs (in-memory only);
# they are NEVER stored server-side — the user's browser (localStorage)
# is the only place they are saved. When a user supplies a key for a
# provider, that job spends the user's own quota, never the owner's.
# The one owner account: may upload with or without user keys (server
# keys apply when no user keys are supplied).
OWNER_EMAIL=owner@example.com
# Primary Gemini key (fallback chain also tries GEMINI_KEY_01..03 below)
GEMINI_API_KEY=AIzaSy_PLACEHOLDER_PRIMARY_KEY
# Bare GEMINI_KEY is also read by the key-rotation collector (backend/config.py _collect_numbered_keys("GEMINI_KEY")).
GEMINI_KEY=PLACEHOLDER_BARE_GEMINI_KEY
# Key rotation pool (health checker rotates when a key hits its limit)
GEMINI_KEY_01=AIzaSy_PLACEHOLDER_KEY_01
GEMINI_KEY_02=AIzaSy_PLACEHOLDER_KEY_02
GEMINI_KEY_03=AIzaSy_PLACEHOLDER_KEY_03
GEMINI_MODEL=gemini-2.0-flash

# Fast transcript analysis fallback
GROQ_API_KEY=gsk_PLACEHOLDER_GROQ_KEY
# Bare GROQ_KEY is also read by the rotation collector.
GROQ_KEY=PLACEHOLDER_BARE_GROQ_KEY
GROQ_KEY_01=gsk_PLACEHOLDER_GROQ_KEY_01
GROQ_KEY_02=gsk_PLACEHOLDER_GROQ_KEY_02
GROQ_MODEL=llama-3.3-70b-versatile

# Backup LLM (OpenRouter free-tier models)
OPENROUTER_API_KEY=sk-or-v1_PLACEHOLDER_OPENROUTER_KEY
# Bare OPENROUTER_KEY is also read by the rotation collector.
OPENROUTER_KEY=PLACEHOLDER_BARE_OPENROUTER_KEY
OPENROUTER_KEY_01=sk-or-v1_PLACEHOLDER_OPENROUTER_KEY_01
OPENROUTER_KEY_02=sk-or-v1_PLACEHOLDER_OPENROUTER_KEY_02
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Hugging Face (open-source vision/text models)
HF_TOKEN=hf_PLACEHOLDER_TOKEN
HF_VISION_MODELS=llava-hf/llava-1.5-7b-hf,Qwen/Qwen2-VL-7B-Instruct,openbmb/MiniCPM-V-2_6

# Provider health-check cadence (seconds)
PROVIDER_HEALTH_CHECK_SECONDS=300

# ---- Email (OAuth 2.0 ONLY — never store passwords) ----
EMAIL_PROVIDER=gmail
# Master switch: false => log-only no-op (no mail is sent)
EMAIL_ENABLED=false
# Gmail OAuth2 (create in Google Cloud Console)
GMAIL_CLIENT_ID=123456789012-PLACEHOLDER.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-PLACEHOLDER_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=1//PLACEHOLDER_REFRESH_TOKEN
GMAIL_SENDER=recaps@PLACEHOLDER_DOMAIN.example
# Microsoft Graph alternative (create in Azure portal)
MSGRAPH_TENANT_ID=PLACEHOLDER_TENANT_ID
MSGRAPH_CLIENT_ID=PLACEHOLDER_MSGRAPH_CLIENT_ID
MSGRAPH_CLIENT_SECRET=PLACEHOLDER_MSGRAPH_CLIENT_SECRET
MSGRAPH_SENDER=recaps@PLACEHOLDER_DOMAIN.example

# ---- Storage (Cloudflare R2 or Supabase Storage) ----
# Buckets mirror the local storage/ layout:
# uploads / processing / results / thumbnails / reports
R2_ACCOUNT_ID=PLACEHOLDER_ACCOUNT_ID
R2_ACCESS_KEY_ID=PLACEHOLDER_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=PLACEHOLDER_SECRET_ACCESS_KEY
R2_BUCKET_UPLOADS=recap-uploads
# NOTE (infra fix 2026-10-14): R2_BUCKET_PROCESSING / R2_BUCKET_THUMBNAILS
# are NOT read by backend/config.py — the R2 backend (backend/storage/r2.py)
# only uses UPLOADS / RESULTS / TEMP and routes every other top-level key
# (processing, thumbnails, reports) into the TEMP bucket. Create those two
# buckets only if you want them for manual use; the app will not use them.
R2_BUCKET_PROCESSING=recap-processing
R2_BUCKET_RESULTS=recap-results
R2_BUCKET_THUMBNAILS=recap-thumbnails
R2_BUCKET_TEMP=recap-temporary

# ---- Fair-use limits (free tier) ----
MAX_UPLOADS_PER_DAY=5
MAX_PROCESSING_MINUTES_PER_DAY=60
MAX_AI_REQUESTS_PER_DAY=100

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_UPLOAD=10/minute

# ---- CORS (comma-separated EXACT origins; frontend origins) ----
# Wildcards are REJECTED at startup (backend/main.py build_cors_options):
# a wildcard origin + allow_credentials=True would let ANY matching
# subdomain make credentialed API requests. Production: list the exact
# deployed frontend origin(s), e.g. CORS_ORIGINS=https://myan-recap.pages.dev
# Default below is localhost dev origins only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Whisper (local speech-to-text) ----
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ---- Community workers ----
WORKER_GATEWAY_TOKEN=PLACEHOLDER_WORKER_GATEWAY_TOKEN

# ---- Output language for summaries (en | my; user-selectable per request) ----
DEFAULT_OUTPUT_LANG=en

# ---- Service token for n8n -> backend calls (infra-only, not in config.py) ----
# Used as: Authorization: Bearer <token> in the n8n flows
# ($env.RECAP_API_SERVICE_TOKEN). Generate with: openssl rand -hex 32
RECAP_API_SERVICE_TOKEN=PLACEHOLDER_SERVICE_TOKEN_64_HEX_CHARS

# ---- Frontend public config (safe to expose; anon key only) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ANON_KEY_PLACEHOLDER
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend additions (all optional; safe defaults for local dev) ----
# NOTE (infra fix 2026-10-14): ADMIN_EMAILS, DEV_AUTH_BYPASS,
# STORAGE_PROVIDER, WORKER_GATEWAY_TOKEN, EMAIL_ENABLED were previously
# defined TWICE in this file (here and above). Duplicate keys are
# confusing — the single definitions above are authoritative; do not
# re-add them here.

# ---- Added 2026-10-14 (inspection): vars USED by code but previously missing here ----
# All placeholders only — never real values.
# OLLAMA_URL: local Ollama endpoint used by backend/agents/agent04_vision.py
# (read directly via os.environ; NOT a Settings field in backend/config.py).
OLLAMA_URL=http://localhost:11434
# NEXT_PUBLIC_DEFAULT_LOCALE: frontend default locale ("my" | "en"); also in
# frontend/.env.example. Read by frontend/lib/i18n.tsx + frontend/app/layout.tsx.
NEXT_PUBLIC_DEFAULT_LOCALE=my
# n8n-only infra vars (documented in n8n/README.md; NOT backend Settings fields):
# base URL the n8n flows call, and the ops alert webhook for the monitor flow.
RECAP_API_URL=http://localhost:8000
RECAP_ALERT_WEBHOOK_URL=https://PLACEHOLDER_ALERT_WEBHOOK_URL.example/hooks/alert
