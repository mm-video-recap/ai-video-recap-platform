            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check API Health": {
      "main": [
        [
          {
            "index": 0,
            "node": "Check Queue Status",
            "type": "main"
          }
        ],
        [
          {
            "node": "Fetch Recent Errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Queue Status": {
      "main": [
        [
          {
